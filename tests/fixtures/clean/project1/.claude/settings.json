{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{"type": "command", "command": "scripts/pretooluse-audit.sh"}]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [{"type": "command", "command": "npm run lint:staged"}]
      }
    ],
    "SessionStart": [
      {
        "hooks": [{"type": "command", "command": "echo session started"}]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Read(./src/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(rm -rf:*)"
    ],
    "additionalDirectories": ["./scripts/"]
  },
  "mcpServers": {
    "docs": {
      "type": "http",
      "url": "https://mcp.example.com/docs/sse"
    }
  }
}
